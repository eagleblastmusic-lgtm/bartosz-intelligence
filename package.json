{
  "name": "bartosz-intelligence",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "lint": "eslint apps packages tools tests",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json && tsc -p tests/workers/tsconfig.json",
    "build": "pnpm --filter @bartosz/web build && pnpm --filter @bartosz/api build && pnpm -r --filter @bartosz/contracts --filter @bartosz/core --filter @bartosz/telemetry build",
    "verify:config": "tsx tools/verify-config.ts",
    "verify:bundle": "tsx tools/registry/verify-bundle.ts && tsx tools/registry/generate-validators.ts --check",
    "test:unit": "vitest run --project unit",
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm --filter @bartosz/web exec vite --host 127.0.0.1\"",
    "test:workers": "vitest run --project workers",
    "test:contract": "vitest run --project contracts",
    "verify:migrations": "tsx tools/db/verify-migrations.ts",
    "dev:api": "wrangler dev --local --config apps/api/wrangler.jsonc --persist-to .local/worker",
    "test:e2e": "playwright test",
    "gate:e": "tsx --env-file-if-exists=.env tools/gates/eligibility.ts",
    "gate:ai": "tsx tools/gates/ai-pilot.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261004.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "ajv": "8.20.0",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
