# Poświadczenie i worker_id muszą należeć do odrębnej tożsamości D1,
# z jedynym scope FETCH_TRANSCRIPT. Wartości dostarcza właściciel poza repo.
APP_ORIGIN=https://UZUPELNIJ.example
LOCAL_WORKER_CREDENTIAL=UZUPELNIJ_POZA_REPOZYTORIUM
BARTOSZ_WORKER_ID=oracle-frankfurt-transcript-1
BARTOSZ_CONCURRENCY=1
BARTOSZ_PYTHON=/opt/bartosz-intelligence/runtime/python/bin/python
BARTOSZ_DENO=/opt/bartosz-intelligence/runtime/deno-2.9.7/deno
BARTOSZ_FFMPEG=/usr/bin/ffmpeg
BARTOSZ_STATE_DIRECTORY=/var/lib/bartosz-executor
BARTOSZ_CAPTION_SOCKET=/run/bartosz-caption-broker/caption.sock
# Zmienić dopiero po zapisaniu PASS pełnych transkrypcji z tej instancji.
BARTOSZ_SOURCE_QUALIFIED=false
HOME=/var/lib/bartosz-executor
DENO_DIR=/var/cache/bartosz-executor/deno
TMPDIR=/var/lib/bartosz-executor/tmp
NODE_OPTIONS=--max-old-space-size=192
